<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>물고기 밥주기 게임 (Aqua Care)</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body { font-family: system-ui, -apple-system, sans-serif; user-select: none; }
        canvas { touch-action: none; cursor: crosshair; }
    </style>
</head>
<body class="bg-slate-900 text-white min-h-screen flex flex-col items-center justify-center p-4">

    <!-- 상단 헤더 & 정보바 -->
    <div class="w-full max-w-4xl bg-slate-800 rounded-t-2xl p-4 flex justify-between items-center shadow-lg">
        <div>
            <h1 class="text-2xl font-bold text-cyan-400">🐠 아쿠아 라이프</h1>
            <p class="text-xs text-slate-400">수조를 클릭하여 밥을 주세!</p>
        </div>
        <div class="flex gap-6 text-sm md:text-base">
            <div class="bg-slate-700 px-4 py-2 rounded-xl flex items-center gap-2">
                💰 <span id="coin-val" class="font-bold text-yellow-400">100</span> 코인
            </div>
            <div class="bg-slate-700 px-4 py-2 rounded-xl flex items-center gap-2">
                🐟 <span id="fish-count" class="font-bold text-cyan-300">1</span> / <span id="max-fish">10</span> 마리
            </div>
            <button id="clean-btn" class="bg-blue-600 hover:bg-blue-500 px-4 py-2 rounded-xl font-semibold transition">
                🧹 청소하기 (10코인)
            </button>
        </div>
    </div>

    <!-- 메인 게임 메인 Canvas -->
    <div class="relative w-full max-w-4xl h-[450px] bg-gradient-to-b from-sky-400 via-blue-600 to-indigo-900 shadow-2xl overflow-hidden border-x-4 border-slate-700">
        <canvas id="gameCanvas" class="w-full h-full"></canvas>
        <div class="absolute bottom-2 left-4 text-xs text-cyan-200/60 pointer-events-none">
            수질: <span id="water-quality">100</span>%
        </div>
    </div>

    <!-- 하단 상점 컨트롤러 -->
    <div class="w-full max-w-4xl bg-slate-800 rounded-b-2xl p-4 shadow-lg flex flex-wrap gap-3 justify-center">
        <button id="buy-goldfish" class="bg-amber-600 hover:bg-amber-500 px-4 py-2 rounded-xl text-sm font-semibold transition">
            🐠 금붕어 구매 (50코인)
        </button>
        <button id="buy-clownfish" class="bg-orange-600 hover:bg-orange-500 px-4 py-2 rounded-xl text-sm font-semibold transition">
            🤡 흰동가리 구매 (150코인)
        </button>
        <button id="buy-feeder" class="bg-emerald-600 hover:bg-emerald-500 px-4 py-2 rounded-xl text-sm font-semibold transition">
            ⚙️ 자동 먹이기 (200코인)
        </button>
        <button id="reset-btn" class="bg-rose-600 hover:bg-rose-500 px-3 py-2 rounded-xl text-xs font-semibold ml-auto transition">
            초기화
        </button>
    </div>

    <script>
        const canvas = document.getElementById('gameCanvas');
        const ctx = canvas.getContext('2d');
        
        // 캔버스 크기 맞춤
        function resizeCanvas() {
            canvas.width = canvas.parentElement.clientWidth;
            canvas.height = canvas.parentElement.clientHeight;
        }
        resizeCanvas();
        window.addEventListener('resize', resizeCanvas);

        // 게임 상태
        let state = {
            coins: 100,
            waterQuality: 100,
            hasAutoFeeder: false,
            maxFish: 8
        };

        let fishes = [];
        let foods = [];
        let particles = [];

        // 오디오 효과 (Web Audio API)
        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        function playSound(freq, type = 'sine', duration = 0.1) {
            try {
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.type = type;
                osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
                gain.gain.setValueAtTime(0.1, audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + duration);
                osc.connect(gain);
                gain.connect(audioCtx.destination);
                osc.start();
                osc.stop(audioCtx.currentTime + duration);
            } catch(e){}
        }

        // 물고기 클래스
        class Fish {
            constructor(type = 'goldfish') {
                this.x = Math.random() * (canvas.width - 60) + 30;
                this.y = Math.random() * (canvas.height - 100) + 50;
                this.type = type;
                this.size = type === 'goldfish' ? 20 : 25;
                this.color = type === 'goldfish' ? '#f97316' : '#ef4444';
                this.speed = Math.random() * 1.5 + 1;
                this.dx = (Math.random() - 0.5) * this.speed * 2;
                this.dy = (Math.random() - 0.5) * this.speed;
                this.exp = 0;
                this.level = 1;
                this.lastCoin = Date.now();
            }

            update() {
                // 가장 가까운 먹이 찾기
                let nearestFood = null;
                let minDist = Infinity;
                foods.forEach(food => {
                    let d = Math.hypot(food.x - this.x, food.y - this.y);
                    if (d < minDist) {
                        minDist = d;
                        nearestFood = food;
                    }
                });

                if (nearestFood && minDist < 200) {
                    let angle = Math.atan2(nearestFood.y - this.y, nearestFood.x - this.x);
                    this.dx = Math.cos(angle) * (this.speed * 1.5);
                    this.dy = Math.sin(angle) * (this.speed * 1.5);
                } else {
                    if (Math.random() < 0.02) {
                        this.dx = (Math.random() - 0.5) * this.speed * 2;
                        this.dy = (Math.random() - 0.5) * this.speed;
                    }
                }

                this.x += this.dx;
                this.y += this.dy;

                // 벽 반사
                if (this.x < 30 || this.x > canvas.width - 30) this.dx *= -1;
                if (this.y < 30 || this.y > canvas.height - 50) this.dy *= -1;

                // 먹이 먹기 검사
                foods.forEach((food, index) => {
                    if (Math.hypot(food.x - this.x, food.y - this.y) < this.size) {
                        foods.splice(index, 1);
                        this.exp += 25;
                        playSound(600, 'sine', 0.15);
                        if (this.exp >= 100) {
                            this.level++;
                            this.exp = 0;
                            this.size += 4;
                            playSound(800, 'triangle', 0.3);
                        }
                    }
                });

                // 코인 생산 (10초 마다)
                if (Date.now() - this.lastCoin > 10000) {
                    let reward = this.type === 'goldfish' ? 5 : 15;
                    state.coins += reward * this.level;
                    this.lastCoin = Date.now();
                    playSound(1000, 'sine', 0.1);
                    updateUI();
                }
            }

            draw() {
                ctx.save();
                ctx.translate(this.x, this.y);
                if (this.dx < 0) ctx.scale(-1, 1);

                // 몸통
                ctx.fillStyle = this.color;
                ctx.beginPath();
                ctx.ellipse(0, 0, this.size, this.size * 0.6, 0, 0, Math.PI * 2);
                ctx.fill();

                // 꼬리
                ctx.beginPath();
                ctx.moveTo(-this.size + 4, 0);
                ctx.lineTo(-this.size - 10, -8);
                ctx.lineTo(-this.size - 10, 8);
                ctx.closePath();
                ctx.fill();

                // 눈
                ctx.fillStyle = '#ffffff';
                ctx.beginPath();
                ctx.arc(this.size * 0.5, -this.size * 0.2, 4, 0, Math.PI * 2);
                ctx.fill();
                ctx.fillStyle = '#000000';
                ctx.beginPath();
                ctx.arc(this.size * 0.5 + 1, -this.size * 0.2, 2, 0, Math.PI * 2);
                ctx.fill();

                // 레벨 표시
                ctx.fillStyle = '#ffffff';
                ctx.font = '10px sans-serif';
                ctx.fillText(`Lv.${this.level}`, -10, -this.size);

                ctx.restore();
            }
        }

        // 초기 시작 물고기
        fishes.push(new Fish('goldfish'));

        // 클릭으로 먹기 주기
        canvas.addEventListener('pointerdown', (e) => {
            const rect = canvas.getBoundingClientRect();
            foods.push({
                x: e.clientX - rect.left,
                y: e.clientY - rect.top,
                speed: 1.5
            });
            playSound(300, 'sine', 0.05);
        });

        // 자동 먹이 공급
        setInterval(() => {
            if (state.hasAutoFeeder && fishes.length > 0) {
                foods.push({
                    x: Math.random() * (canvas.width - 40) + 20,
                    y: 10,
                    speed: 1.5
                });
            }
        }, 4000);

        // UI 갱신
        function updateUI() {
            document.getElementById('coin-val').innerText = state.coins;
            document.getElementById('fish-count').innerText = fishes.length;
            document.getElementById('max-fish').innerText = state.maxFish;
            document.getElementById('water-quality').innerText = Math.round(state.waterQuality);
        }

        // 상점 버튼 이벤트
        document.getElementById('buy-goldfish').onclick = () => {
            if (state.coins >= 50 && fishes.length < state.maxFish) {
                state.coins -= 50;
                fishes.push(new Fish('goldfish'));
                updateUI();
            }
        };

        document.getElementById('buy-clownfish').onclick = () => {
            if (state.coins >= 150 && fishes.length < state.maxFish) {
                state.coins -= 150;
                fishes.push(new Fish('clownfish'));
                updateUI();
            }
        };

        document.getElementById('buy-feeder').onclick = (e) => {
            if (state.coins >= 200 && !state.hasAutoFeeder) {
                state.coins -= 200;
                state.hasAutoFeeder = true;
                e.target.innerText = '⚙️ 자동 먹이기 (보유중)';
                e.target.disabled = true;
                e.target.classList.add('opacity-50');
                updateUI();
            }
        };

        document.getElementById('clean-btn').onclick = () => {
            if (state.coins >= 10 && state.waterQuality < 100) {
                state.coins -= 10;
                state.waterQuality = 100;
                updateUI();
            }
        };

        document.getElementById('reset-btn').onclick = () => {
            if (confirm('게임 데이터를 초기화하시겠습니까?')) {
                state.coins = 100;
                state.waterQuality = 100;
                state.hasAutoFeeder = false;
                fishes = [new Fish('goldfish')];
                foods = [];
                updateUI();
            }
        };

        // 루프 애니메이션
        function animate() {
            // 배경 청소 상태에 따른 탁도 연출
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            
            // 물 오염 레이어
            if (state.waterQuality < 100) {
                ctx.fillStyle = `rgba(60, 50, 20, ${ (100 - state.waterQuality) * 0.005 })`;
                ctx.fillRect(0, 0, canvas.width, canvas.height);
            }

            // 먹이 업데이트 및 그리기
            foods.forEach((food, index) => {
                food.y += food.speed;
                ctx.fillStyle = '#d97706';
                ctx.beginPath();
                ctx.arc(food.x, food.y, 4, 0, Math.PI * 2);
                ctx.fill();

                // 바닥 도착 시 삭제
                if (food.y > canvas.height - 10) {
                    foods.splice(index, 1);
                    state.waterQuality = Math.max(0, state.waterQuality - 0.5);
                    updateUI();
                }
            });

            // 물고기 업데이트 및 그리기
            fishes.forEach(fish => {
                fish.update();
                fish.draw();
            });

            requestAnimationFrame(animate);
        }

        animate();
        updateUI();
    </script>
</body>
</html>
